// Demo subset of TECHNICAL.md §T2 (outcomes-store data model).
//
// Datasource is SQLite for local dev; the schema is kept Postgres-compatible
// (no SQLite-only features) so the datasource can be swapped to Supabase
// Postgres at deploy time. Enum-like fields are plain String columns with the
// allowed values documented — string-check constraints / native enums are
// added when we land on Postgres. JSON payloads are stored as JSON strings
// (String columns) for the same reason.

generator client {
  provider = "prisma-client-js"
  // "native" keeps local dev/CI working; the darwin/windows targets are
  // bundled into the client evaluation package (scripts/package-eval.mjs)
  // so it runs on Apple Silicon, Intel Mac, and Windows machines.
  binaryTargets = ["native", "darwin-arm64", "darwin", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity split (T2.1). The outcomes models below know only participantId.
// DemoIdentity is the demo stand-in for the production Identity & Consent
// Service (ICS): display fields live ONLY here, and outcomes queries must
// never join DemoIdentity except in explicitly identified-tier views.
// ---------------------------------------------------------------------------

model Participant {
  id                   String   @id @default(uuid())
  yearOfBirth          Int
  sex                  String // "male" | "female"
  enrollmentTouchpoint String // "clinic" | "retail"
  createdAt            DateTime @default(now())
  /// Terminal lifecycle invariant (audit F-01): "active" |
  /// "deletion_pending" | "deleting" | "deleted". Every consent mutation and
  /// every subject-data write re-checks this INSIDE its own transaction
  /// (assertActiveParticipant); "deleted" is terminal — no grant, scope
  /// revision, restore, enrollment, device/event/episode registration,
  /// import, or simulated night can ever be recorded against a tombstone.
  lifecycleState       String   @default("active")
  /// Tombstone marker (deletion workflow, SPEC §9.4): set when a deletion
  /// request is executed. The row itself is retained so the immutable
  /// consent ledger keeps a valid subject reference; every identified-tier
  /// child row is hard-deleted at the same moment.
  deletedAt            DateTime?

  identity          DemoIdentity?
  consentRecords    ConsentRecord[]
  episodes          Episode[]
  treatmentEvents   TreatmentEvent[]
  devices           Device[]
  mattressPurchases MattressPurchase[]
  sleepSessions     SleepSession[]
  observations      Observation[]
  proResponses      ProResponse[]
  deletionRequests  DeletionRequest[]
}

/// Demo-only display fields, split from Participant to mirror the production
/// identity split (ICS vs. outcomes store). Never joined in outcomes queries.
model DemoIdentity {
  id            String @id @default(uuid())
  participantId String @unique
  displayName   String
  email         String

  participant Participant @relation(fields: [participantId], references: [id])
}

// ---------------------------------------------------------------------------
// Consent (T2.6), consent-state-machine v2 (audit F-02/F-05/F-14): rows are
// IMMUTABLE EVENTS. A grant, a revocation, and a scope revision each append a
// new record; existing records are never updated or deleted, so the ledger is
// literally append-only. The current state of an instrument is projected from
// its highest-revision event; the per-instrument `revision` is monotonic and
// database-unique, which gives every revision a compare-and-swap anchor
// (concurrent revisions cannot silently overwrite each other).
// ---------------------------------------------------------------------------

model ConsentRecord {
  id                String    @id @default(uuid())
  participantId     String
  instrumentType    String // "LANE_A" | "LANE_B" | "LANE_C"
  instrumentVersion String
  /// "grant" (participant-signed; contributes to the authorized-scope
  /// ceiling) | "revoke" | "scope_revision" (administrative revision, must
  /// stay inside the signed ceiling)
  eventType         String    @default("grant")
  /// Monotonic per (participant, instrument) event sequence — the CAS anchor.
  revision          Int       @default(0)
  status            String // "granted" | "revoked" | "expired"
  grantedAt         DateTime
  revokedAt         DateTime?
  /// JSON string: array of { dataClass, use } grants (ConsentScope[])
  scope             String
  createdAt         DateTime  @default(now())

  participant Participant @relation(fields: [participantId], references: [id])

  @@unique([participantId, instrumentType, revision])
  @@index([participantId, instrumentType])
}

model Episode {
  id            String    @id @default(uuid())
  participantId String
  protocolPhase String // "baseline" | "intervention" | "followup"
  startDate     DateTime
  endDate       DateTime?
  /// Consent lineage (audit F-09): the data class whose grant gates this
  /// episode — set from the treatment anchor at creation and validated by
  /// the policy repository. NULL/unknown reads as unclassified and is NEVER
  /// readable or exportable (fail closed).
  dataClass     String?

  participant Participant @relation(fields: [participantId], references: [id])

  @@index([participantId])
}

model TreatmentEvent {
  id            String   @id @default(uuid())
  participantId String
  type          String // "cpap_setup" | "appliance_delivery" | "mattress_delivery" | "titration_change" | "therapy_stop"
  eventDate     DateTime
  /// JSON string
  detail        String
  /// Consent lineage (audit F-06): cpap_setup/titration_change/therapy_stop
  /// → cpap_telemetry; appliance_delivery → hst_clinical; mattress_delivery
  /// → mattress_purchase. NULL/unknown is unreadable (fail closed).
  dataClass     String?

  participant Participant @relation(fields: [participantId], references: [id])

  @@index([participantId, type])
}

model Device {
  id            String    @id @default(uuid())
  participantId String
  deviceClass   String // "wearable" | "cpap" | "sleep_mat" | "appliance"
  make          String
  model         String
  assignedAt    DateTime
  returnedAt    DateTime?
  /// Consent lineage (audit F-03): the data class whose grant gates this
  /// registration (wearable → wearable_sleep, cpap → cpap_telemetry,
  /// sleep_mat → sleep_mat, appliance → hst_clinical). NULL/unknown is
  /// unreadable (fail closed).
  dataClass     String?

  participant  Participant   @relation(fields: [participantId], references: [id])
  sleepSession SleepSession[]
  observations Observation[]

  @@index([participantId, deviceClass])
}

/// Curated reference data (T2.4 catalog); Tempur-Pedic lines seeded first.
model MattressCatalog {
  sku            String @id
  brand          String
  model          String
  firmnessRating Int // normalized 1-10
  materialClass  String // "memory_foam" | "hybrid" | "innerspring" | "latex"
  size           String

  purchases MattressPurchase[]
}

model MattressPurchase {
  id            String    @id @default(uuid())
  participantId String
  sku           String
  purchaseDate  DateTime
  deliveryDate  DateTime? // delivery date = exposure change timestamp
  storeId       String

  participant Participant     @relation(fields: [participantId], references: [id])
  catalogItem MattressCatalog @relation(fields: [sku], references: [sku])

  @@index([participantId])
}

model SleepSession {
  id            String   @id @default(uuid())
  participantId String
  source        String // e.g. "healthkit" | "aggregator:garmin" | "sleep_mat"
  deviceId      String?
  startTs       DateTime
  endTs         DateTime
  /// JSON string: stages, efficiency, interruptions, ...
  summary       String
  /// Import provenance (audit v2 HIGH fix): the ImportBatch receipt this row
  /// arrived under. NULL for every non-import row (seed, time machine,
  /// enrollment flows).
  batchId       String?

  participant Participant @relation(fields: [participantId], references: [id])
  device      Device?     @relation(fields: [deviceId], references: [id])

  @@index([participantId, startTs])
  @@index([batchId])
}

/// Canonical time-series record (T2.3). Adding a source never adds columns.
model Observation {
  id            String   @id @default(uuid())
  participantId String
  source        String // "airview" | "aggregator:garmin" | "healthkit" | "sleep_mat" | "hst" | "pro" | "pos" | ...
  deviceId      String?
  concept       String // "cpap_usage_minutes" | "residual_ahi" | "supine_time_pct" | "therapy_gap" | ...
  valueNumeric  Float?
  valueText     String?
  unit          String?
  effectiveDate DateTime
  grain         String // "raw" | "session" | "day" | "period"
  /// JSON string array, e.g. ["short_wear","device_gap"]
  qualityFlags  String
  ingestedAt    DateTime @default(now())
  /// Import provenance (audit v2 HIGH fix): the ImportBatch receipt this row
  /// arrived under. NULL for every non-import row (seed, time machine,
  /// enrollment flows).
  batchId       String?

  participant Participant @relation(fields: [participantId], references: [id])
  device      Device?     @relation(fields: [deviceId], references: [id])

  @@index([participantId, concept, effectiveDate])
  @@index([concept, effectiveDate])
  @@index([batchId])
}

model ProResponse {
  id                String   @id @default(uuid())
  participantId     String
  instrument        String // "ESS" | "ISI" | "STOP_BANG" | "nightly_wear"
  instrumentVersion String
  administeredAt    DateTime
  /// JSON string: per-item scores
  itemScores        String
  totalScore        Float

  participant Participant @relation(fields: [participantId], references: [id])

  @@index([participantId, instrument, administeredAt])
}

/// Consumer deletion request (SPEC §9.4 withdrawal & deletion; DEMO.md
/// reserve → working). Deletion is STRONGER than revocation: executing a
/// request revokes every consent AND hard-deletes the identified-tier rows.
/// The consent ledger and the tombstoned Participant row survive (append-
/// only, legally required); already-published de-identified mart releases
/// are immutable and cannot be recalled.
model DeletionRequest {
  id            String    @id @default(uuid())
  participantId String
  /// sim-clock date the participant filed the request
  requestedAt   DateTime
  status        String // "pending" | "executing" | "executed" | "declined"
  note          String?
  /// Database-enforced one-active-request-per-participant invariant (audit
  /// F-08): set to participantId while the request is pending/executing,
  /// NULL once resolved — the unique index rejects a concurrent duplicate.
  activeKey     String?   @unique
  /// sim-clock date the compliance console executed (or declined) it
  resolvedAt    DateTime?
  /// JSON string: per-table deleted-row counts recorded at execution
  /// (feeds the confirmation panel and the printable certificate)
  deletionCounts String?
  /// consent-ledger reference at execution: retained-record count + last id
  ledgerRef     String?
  /// Ledger record count captured atomically at execution — the certificate
  /// renders ONLY from this stored snapshot, never from a live query.
  ledgerCount   Int?
  /// Observable workflow metadata (level-up 8): every execution attempt is
  /// recorded OUTSIDE the atomic transaction, so a failed attempt leaves an
  /// audit trace while the request itself rolls back to `pending`.
  attempts        Int       @default(0)
  lastAttemptAt   DateTime?
  /// Populated when the latest execution attempt failed (the retryable
  /// failure path); cleared by a successful execution.
  lastAttemptError String?
  /// Immutable certificate content hash (level-up 8): SHA-256 over the
  /// stored execution-snapshot fields, computed and stored inside the
  /// execution transaction. The printable certificate displays it; any
  /// later drift between certificate and snapshot is detectable.
  contentHash   String?
  createdAt     DateTime  @default(now())

  participant Participant @relation(fields: [participantId], references: [id])

  @@index([participantId, status])
  @@index([status, requestedAt])
}

/// Saved cohort-explorer filter set (demo-prep bookmarks; DEMO.md reserve →
/// working). Stores the explorer's URL query string plus a consent-filtered
/// member-count snapshot taken at save time — no participant ids, ever.
model SavedCohort {
  id          String   @id @default(uuid())
  name        String
  /// URL query string of validated explorer filters (e.g. "supine=y&firmness=medium")
  query       String
  /// consent-filtered matched count at save time (display only; live count on open)
  matched     Int
  cohortTotal Int
  /// sim-clock date at save time
  clockDate   DateTime
  createdAt   DateTime @default(now())
}

/// Disclosure-control release ledger (audit F-12, level-up 10): one row per
/// partner-facing count release. Every count a partner surface releases —
/// proposal feasibility numbers, dashboard tiles/tables — is banded
/// (never exact) and logged here with the surface, the canonical query, the
/// metric, the band that left the system, and the sim-clock date. Viewable
/// at /partner/releases (DUA-gated).
model ReleaseLedgerEntry {
  id        String   @id @default(uuid())
  surface   String // "partner_proposal" | "partner_dashboard"
  /// canonical query descriptor (preset + validated filters)
  query     String
  /// which released number this row logs (e.g. "matched", "firmness:soft")
  metric    String
  /// the band actually released (e.g. "11–20", "<11 (suppressed)")
  band      String
  /// sim-clock date at release
  clockDate DateTime
  createdAt DateTime @default(now())

  @@index([surface, createdAt])
}

/// Governed-model decision log (level-up 12): one row per rendered
/// recommendation card per sim date. Every card the template engine emits is
/// schema-validated (zod RecommendationDraft) and run through the SafetyCheck
/// chain (denylist + claim-evidence linkage + guardrail-class validator);
/// the outcome of every check is recorded here — model id + version, checks
/// passed, sim date — and displayed read-only at /compliance/model-log. A
/// future governed LLM logs through the exact same row shape.
model ModelDecisionLog {
  id            String   @id @default(uuid())
  participantId String
  ruleId        String
  /// SPEC §10.3 guardrail class of the rendered card
  guardrail     String
  /// generation engine id ("templates-v1" today; a governed LLM later)
  model         String
  modelVersion  String
  /// RecommendationDraft passed zod validation before rendering
  schemaValid   Boolean
  /// JSON string: SafetyCheck[] — { id, label, passed, detail }
  checks        String
  /// every safety check passed (a failed card is never rendered)
  passed        Boolean
  /// sim-clock date the card was rendered for
  simDate       DateTime
  /// Clinician-review stub (level-up 12): provider-class cards are queued
  /// for review; the model-log page's "Mark reviewed (demo)" button fills
  /// these in. Structure only — no real clinician workflow in the demo.
  reviewQueued  Boolean  @default(false)
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())

  /// One log row per card per engine version per sim date — re-rendering a
  /// page never duplicates its audit trail.
  @@unique([participantId, ruleId, model, modelVersion, simDate])
  @@index([createdAt])
  @@index([reviewQueued, reviewedAt])
}

/// Seed-stamped marker (level-up 11 scenario sweep hook): written once by
/// `npm run seed` so every surface can state which effect-size scenario the
/// database was actually seeded with — and warn when the running server's
/// SCENARIO env disagrees (the time machine would generate inconsistent
/// nights). Fully deterministic: no wall-clock timestamps.
model SeedInfo {
  id         String   @id @default("singleton")
  /// "default" | "null" (src/lib/synthetic/profiles.ts seedScenario)
  scenario   String
  cohortSize Int
  /// sim-clock date at seed time (deterministic, pinned)
  clockDate  DateTime
}

/// Server-owned staged import awaiting confirmation (audit v2 HIGH fix —
/// the import trust boundary). previewImportUpload/loadSampleImport parse
/// the file server-side, validate the result against the connector schema,
/// and store the normalized payload HERE; confirmImport accepts only
/// (token, participantId, alignToSimClock) and ingests from this server
/// copy. The parsed payload never round-trips through the browser, so a
/// forged `kind`/`source`/concept/unit can never reach the ingest gate.
/// Tokens are single-use (consumedAt claimed atomically) and expire after
/// ~15 wall-clock minutes (sim-clock-agnostic: staging is operator session
/// state, not subject-timeline data).
model PendingImport {
  id            String    @id @default(uuid())
  /// single-use opaque confirmation token (256-bit, base64url)
  token         String    @unique
  participantId String
  /// connector kind: "apple_health" | "airview"
  kind          String
  /// canonical source from the server-owned connector schema
  source        String
  /// JSON string: the normalized ParsedImportPayload (server copy)
  payload       String
  /// SHA-256 hex digest of the uploaded file bytes
  fileDigest    String
  parserVersion String
  createdAt     DateTime  @default(now())
  /// wall-clock expiry (createdAt + ~15 min)
  expiresAt     DateTime
  /// set atomically when confirmImport consumes the token (single use)
  consumedAt    DateTime?

  @@index([participantId])
  @@index([expiresAt])
}

/// Import provenance receipt (audit v2 prioritized fix 6): one row per
/// confirmed import, created INSIDE the same consent-guarded transaction
/// that admits the batch. Records the connector, canonical source, the data
/// class the rows were admitted under, parser version, source-file digest,
/// the PendingImport token id consumed, and the consent event (instrument +
/// revision) that authorized the collect at admission. Imported
/// Observation/SleepSession rows link back via their batchId column.
model ImportBatch {
  id                String   @id @default(uuid())
  participantId     String
  kind              String
  source            String
  dataClass         String
  parserVersion     String
  fileDigest        String
  /// PendingImport row id consumed (null: direct in-process ingest, tests)
  tokenId           String?
  /// consent event that authorized the admission (e.g. "LANE_B")
  consentInstrument String
  /// revision of that consent event at admission time
  consentRevision   Int
  observationCount  Int      @default(0)
  sessionCount      Int      @default(0)
  createdAt         DateTime @default(now())

  @@index([participantId, createdAt])
}

/// Singleton row holding the demo "current date" (the time machine's clock).
model SimClock {
  id          String   @id @default("singleton")
  currentDate DateTime
}
